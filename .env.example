# OpenAI API Key for post generation
OPENAI_API_KEY=your_openai_api_key_here

# LinkedIn OAuth 2.0 Credentials
# Create an app at https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your_linkedin_client_id
